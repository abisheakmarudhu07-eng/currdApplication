{
  "name": "currd-application",
  "version": "0.1.0",
  "private": true,
  "description": "Food and fitness tracking application",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client",
    "db:setup": "npm --workspace server run db:setup",
    "cold-start": "npm run db:setup",
    "food:build": "py -3 scripts/food-data/build_food_candidates.py --output-dir build/food-import",
    "food:stage": "npm --workspace server run food:stage",
    "db:docker:start": "docker compose --profile docker-mysql up -d mysql",
    "db:docker:stop": "docker compose --profile docker-mysql stop mysql"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
