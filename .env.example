# Copy to .env and replace every CHANGE_ME value before starting the app.
# Never commit .env. These values are local to each developer's machine.
APP_ENV=development
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api

# Native MySQL on the Windows host (verified server: MySQL 8.0.36, port 3306).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=food_fitness_tracker

# Runtime account: SELECT/INSERT/UPDATE/DELETE only. Use the real password
# assigned to this account; never assume a blank password from Workbench behavior.
MYSQL_USER=food_app
MYSQL_PASSWORD=CHANGE_ME_food_app_password

# Separate account used only by database migrations and controlled seed setup.
# It requires schema DDL privileges and should not be used by the API at runtime.
MYSQL_MIGRATION_USER=food_migrator
MYSQL_MIGRATION_PASSWORD=CHANGE_ME_food_migrator_password

# Optional Docker-only MySQL settings. Not used by the native-MySQL cold start.
# Use these only if you explicitly choose to run the optional container instead.
MYSQL_DOCKER_PORT=3307
MYSQL_DOCKER_ROOT_PASSWORD=CHANGE_ME_docker_root_password
